# auto-normalize any added text files to LF on checkin
*	text=auto

# use Windows line endings for DOS/Windows shell scripts
*.bat	text eol=crlf
# use Unix line endings for Linux/macOS shell scripts
*.sh 	text eol=lf

# for github linguist 
*.h	linguist-language=C++

# vcpkg overlay ports must be byte-for-byte as in the vcpkg repo (which uses
# '* -text'); CRLF conversion on Windows checkouts breaks applying patches
vcpkg-ports/** -text
